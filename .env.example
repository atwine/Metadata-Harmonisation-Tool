# ============================================================================
# Metadata Harmonisation Tool - Environment Configuration
# ============================================================================
# Copy this file to .env and configure your settings
# DO NOT commit .env files to version control

# ============================================================================
# AI PROVIDER CONFIGURATIONS
# ============================================================================

# ----------------------------------------------------------------------------
# Ollama Configuration (Local AI Processing)
# ----------------------------------------------------------------------------
# Base URL for Ollama API (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default models for Ollama
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama connection timeout (seconds)
OLLAMA_TIMEOUT=30

# ----------------------------------------------------------------------------
# OpenAI Configuration
# ----------------------------------------------------------------------------
# OpenAI API Key (required for OpenAI provider)
OPENAI_API_KEY=

# OpenAI API Base URL (optional, for custom endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1

# Default OpenAI models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI organization ID (optional)
OPENAI_ORGANIZATION=

# OpenAI project ID (optional)
OPENAI_PROJECT=

# ----------------------------------------------------------------------------
# Anthropic Configuration
# ----------------------------------------------------------------------------
# Anthropic API Key (required for Anthropic provider)
ANTHROPIC_API_KEY=

# Anthropic API Base URL (optional, for custom endpoints)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default Anthropic models
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# Anthropic API version
ANTHROPIC_API_VERSION=2023-06-01

# ----------------------------------------------------------------------------
# Azure OpenAI Configuration
# ----------------------------------------------------------------------------
# Azure OpenAI API Key (required for Azure OpenAI provider)
AZURE_OPENAI_API_KEY=

# Azure OpenAI endpoint (required for Azure OpenAI provider)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI deployment names (must match your Azure deployments)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
# Run Streamlit in headless mode (no browser auto-open)
STREAMLIT_SERVER_HEADLESS=true

# Server address (0.0.0.0 for Docker, localhost for local development)
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Server port
STREAMLIT_SERVER_PORT=8501

# Enable/disable CORS (Cross-Origin Resource Sharing)
STREAMLIT_SERVER_ENABLE_CORS=false

# Enable/disable XSRF protection (SECURITY: Keep enabled in production)
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true

# File watcher type (auto, poll, none)
STREAMLIT_SERVER_FILE_WATCHER_TYPE=auto

# Enable/disable automatic rerun on file changes
STREAMLIT_SERVER_RUN_ON_SAVE=true

# ----------------------------------------------------------------------------
# UI Configuration
# ----------------------------------------------------------------------------
# Gather usage statistics
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Development mode (enables additional debugging features)
STREAMLIT_GLOBAL_DEVELOPMENT_MODE=false

# Theme configuration
STREAMLIT_THEME_PRIMARY_COLOR=#FF6B6B
STREAMLIT_THEME_BACKGROUND_COLOR=#FFFFFF
STREAMLIT_THEME_SECONDARY_BACKGROUND_COLOR=#F0F2F6
STREAMLIT_THEME_TEXT_COLOR=#262730

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Paths and Directories
# ----------------------------------------------------------------------------
# Input data directory
INPUT_DIR=./input

# Output data directory
OUTPUT_DIR=./output

# Logs directory
LOGS_DIR=./logs

# Temporary files directory
TEMP_DIR=./temp

# ----------------------------------------------------------------------------
# AI Processing Configuration
# ----------------------------------------------------------------------------
# Default AI provider (ollama, openai, anthropic, azure_openai)
DEFAULT_AI_PROVIDER=ollama

# Maximum retry attempts for AI API calls
AI_MAX_RETRIES=3

# Retry delay in seconds
AI_RETRY_DELAY=1

# Request timeout in seconds
AI_REQUEST_TIMEOUT=30

# Maximum tokens for chat responses
AI_MAX_TOKENS=2000

# Temperature for AI responses (0.0 to 1.0)
AI_TEMPERATURE=0.7

# ----------------------------------------------------------------------------
# Data Processing Configuration
# ----------------------------------------------------------------------------
# Maximum file size for uploads (in MB)
MAX_FILE_SIZE_MB=100

# Supported file formats (comma-separated)
SUPPORTED_FORMATS=csv,xlsx,json,xml

# Maximum number of rows to process
MAX_ROWS=10000

# Batch size for processing
BATCH_SIZE=100

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Log Levels
# ----------------------------------------------------------------------------
# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Streamlit log level.
STREAMLIT_LOG_LEVEL=WARNING

# AI provider log level.
AI_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Log Formatting
# ----------------------------------------------------------------------------
# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Date format
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# Enable/disable log rotation
LOG_ROTATION_ENABLED=true

# Log file maximum size (MB)
LOG_MAX_SIZE_MB=10

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# API Security
# ----------------------------------------------------------------------------
# Enable/disable API key validation
API_KEY_VALIDATION=true

# API rate limiting (requests per minute)
API_RATE_LIMIT=60

# Session timeout (minutes)
SESSION_TIMEOUT=30

# ----------------------------------------------------------------------------
# Data Security
# ----------------------------------------------------------------------------
# Enable/disable data encryption at rest
DATA_ENCRYPTION=false

# Encryption key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# Enable/disable audit logging
AUDIT_LOGGING=true

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------
# Enable/disable debug mode
DEBUG_MODE=false

# Enable/disable profiling
PROFILING_ENABLED=false

# Enable/disable test mode
TEST_MODE=false

# Mock AI responses for testing
MOCK_AI_RESPONSES=false

# ----------------------------------------------------------------------------
# Database Configuration (for development/testing)
# ----------------------------------------------------------------------------
# Database URL (SECURITY: Replace with actual credentials, never commit real credentials)
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Enable/disable database migrations
DB_MIGRATIONS_ENABLED=false

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Docker-specific Settings
# ----------------------------------------------------------------------------
# Docker host for accessing host services from container
DOCKER_HOST_IP=host.docker.internal

# Container user ID (for file permissions)
CONTAINER_UID=1000

# Container group ID (for file permissions)
CONTAINER_GID=1000

# ============================================================================
# MONITORING AND METRICS
# ============================================================================

# ----------------------------------------------------------------------------
# Health Checks
# ----------------------------------------------------------------------------
# Health check endpoint path
HEALTH_CHECK_PATH=/_stcore/health

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# Health check timeout (seconds)
HEALTH_CHECK_TIMEOUT=10

# ----------------------------------------------------------------------------
# Metrics Collection
# ----------------------------------------------------------------------------
# Enable/disable metrics collection
METRICS_ENABLED=false

# Metrics endpoint
METRICS_ENDPOINT=/metrics

# Prometheus pushgateway URL (optional)
PROMETHEUS_PUSHGATEWAY_URL=

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# ----------------------------------------------------------------------------
# Memory and CPU
# ----------------------------------------------------------------------------
# Maximum memory usage (MB)
MAX_MEMORY_MB=2048

# Number of worker processes
WORKER_PROCESSES=1

# Thread pool size
THREAD_POOL_SIZE=4

# ----------------------------------------------------------------------------
# Caching
# ----------------------------------------------------------------------------
# Enable/disable caching
CACHING_ENABLED=true

# Cache TTL (seconds)
CACHE_TTL=3600

# Cache backend (memory, redis, file)
CACHE_BACKEND=memory

# Redis URL (if using Redis cache)
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# BACKUP AND RECOVERY
# ============================================================================

# ----------------------------------------------------------------------------
# Backup Configuration
# ----------------------------------------------------------------------------
# Enable/disable automatic backups
BACKUP_ENABLED=false

# Backup interval (hours)
BACKUP_INTERVAL=24

# Backup retention (days)
BACKUP_RETENTION_DAYS=7

# Backup storage path
BACKUP_PATH=./backups

# ============================================================================
# CUSTOM CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Custom Settings
# ----------------------------------------------------------------------------
# Add your custom environment variables here
# CUSTOM_SETTING_1=value1
# CUSTOM_SETTING_2=value2
